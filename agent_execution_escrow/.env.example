HOST=127.0.0.1
PORT=4520
PUBLIC_API_KEYS=
STORE_ENCRYPTED_PAYLOADS=true
PRIVACY_SALT=change-me-before-sharing
NAVA_REQUIRED_EXTERNAL_APPROVALS=1
NAVA_REQUIRE_USER_APPROVAL=false
NAVA_DEFAULT_APPROVAL_AUTHORITY=external_wallet_signatures
VERIFIER_CHALLENGE_TTL_SEC=900
ZEKO_SUBMIT_MODE=record
# Testnet is the compatibility default. For mainnet, use a separate env file
# with fresh verifier/sponsor/deployer keys and a mainnet zkApp deployment.
ZEKO_NETWORK_ID=testnet
ZEKO_SUBMITTER_URL=
ZEKO_SUBMITTER_TOKEN=
ZEKO_ZKAPP_PROJECT_PATH=./zkapp-test
ZEKO_NATIVE_VERIFIERS=
DEPLOYER_PRIVATE_KEY=
SPONSOR_PRIVATE_KEY=
