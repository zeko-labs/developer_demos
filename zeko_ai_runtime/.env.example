#
# Public builder-facing naming prefers `ZEKO_AI_*`.
# Some low-level operator and migration aliases still accept `OPENGRADIENT_*` while the runtime surface finishes moving to neutral names.
#
HOST=127.0.0.1
ZEKO_AI_PORT=5180

# Testnet is the compatibility default. For mainnet, use a separate env file
# with ZEKO_NETWORK_ID=mainnet, official mainnet endpoints, fresh zkApp v2
# deployment records, and production sponsor/operator custody.
ZEKO_NETWORK_ID=testnet
ZEKO_GRAPHQL=https://testnet.zeko.io/graphql
ZEKO_ARCHIVE_GRAPHQL=https://archive.testnet.zeko.io/graphql
ZEKO_EXPLORER=https://zekoscan.io/testnet
TX_FEE=100000000

# Optional deployer key for `npm run zkapp:deploy`.
# If omitted, the deploy script will securely prompt on a TTY.
# DEPLOYER_PRIVATE_KEY=
# ZKAPP_PREFUND_AMOUNT=1000000000

# Optional sponsor key for runtime submission.
# If omitted, `npm run sponsor:enable` can store it locally in `data/deployments/sponsor-private-key.txt`.
# SPONSOR_PRIVATE_KEY=

# Required for building real Zeko receipt transactions on the default `v2` lane.
# ZKAPP_V2_PUBLIC_KEY=
# ZKAPP_V2_PRIVATE_KEY=

# Required only for the legacy `v1` compatibility lane.
# ZKAPP_PUBLIC_KEY=
# ZKAPP_PRIVATE_KEY=

OPENGRADIENT_ETHEREUM_CHAIN_ID=1
# OPENGRADIENT_ETHEREUM_SETTLEMENT_CONTRACT=

# Optional DA relay endpoint compatible with the local zeko-relay payload shape.
# ZEKO_AI_DA_ENDPOINT=http://127.0.0.1:8787/publish
# ZEKO_AI_DA_BEARER_TOKEN=
# ZEKO_AI_DA_SCHEMA=zeko-ai.inference_receipt.v1
# ZEKO_AI_DA_APP_ID=zeko-ai-builder-kit

# Optional explicit signer and attester overrides.
# OPENGRADIENT_ORACLE_PRIVATE_KEY=
# OPENGRADIENT_ATTESTER_PRIVATE_KEYS=key1,key2,key3

# Optional async credits operator lane settings for fast server-side settlement.
# Default auto-processing is a few seconds when sponsor capability is available.
# OPENGRADIENT_CREDITS_OPERATOR_AUTO_PROCESS_MS=3000
# OPENGRADIENT_CREDITS_OPERATOR_MAX_ATTEMPTS=3
# OPENGRADIENT_CREDITS_FAST_DEPOSIT_MINA=0.11

# Optional wallet-funded deposit monitor settings.
# OPENGRADIENT_CREDITS_DEPOSIT_MONITOR_MS=3000
# OPENGRADIENT_CREDITS_DEPOSIT_MONITOR_MAX_ATTEMPTS=60

# Optional coordinator and operator HTTP auth.
# When either inbound variable is set, /api/* requires auth while /health stays open.
# OPENGRADIENT_HTTP_API_KEYS=
# OPENGRADIENT_HTTP_BEARER_TOKENS=
# OPENGRADIENT_OUTBOUND_API_KEY=
# OPENGRADIENT_OUTBOUND_BEARER_TOKEN=
# OPENGRADIENT_BUILDER_AUTH_PATH=/absolute/path/to/data/opengradient/http-auth/builders.json
# OPENGRADIENT_BUILDER_USAGE_PATH=/absolute/path/to/data/opengradient/builder-usage.json

# Optional client-side auth helpers for the builder SDK and smoke:sdk.
# ZEKO_AI_COORDINATOR_URL=http://127.0.0.1:5180
# ZEKO_AI_COORDINATOR_API_KEY=
# ZEKO_AI_COORDINATOR_BEARER_TOKEN=
# ZEKO_AI_COORDINATOR_ENV_FILE=data/zeko-ai/http-auth/sdk.local.env
# ZEKO_AI_COORDINATOR_TIMEOUT_MS=15000

# Optional builder conformance controls for `npm run smoke:builder:conformance`.
# ZEKO_AI_BUILDER_CONFORMANCE_ENV_FILE=data/zeko-ai/http-auth/builders/builder-conformance-local.local.env
# ZEKO_AI_BUILDER_CONFORMANCE_LIVE_SETTLEMENT=false
# ZEKO_AI_BUILDER_CONFORMANCE_WAIT_FOR_SETTLEMENT=false

# Optional compatibility smoke controls for `npm run smoke:compat`.
# ZEKO_AI_COMPAT_ENV_FILE=data/zeko-ai/http-auth/builders/builder-conformance-local.local.env
# ZEKO_AI_COMPAT_LIVE=false
# ZEKO_AI_COMPAT_WAIT_FOR_SETTLEMENT=false
# Optional private-lane smoke control for `npm run smoke:private`.
# ZEKO_AI_PROMPT=private inference smoke

# Optional builder contract validation controls for `npm run contract:builder`.
# ZEKO_AI_BUILDER_CONTRACT_ENV_FILE=data/zeko-ai/http-auth/builders/builder-conformance-local.local.env
# ZEKO_AI_TEST_BUILDER_ENV_FILE=data/zeko-ai/http-auth/builders/builder-conformance-local.local.env

# Optional builder credential issuance helpers for `npm run auth:issue:builder`.
# OPENGRADIENT_BUILDER_ID=builder-demo
# OPENGRADIENT_BUILDER_LABEL=Builder Demo
# OPENGRADIENT_BUILDER_AUTH_MODE=api-key
# OPENGRADIENT_BUILDER_SCOPES=auth:read,operators:read,agents:read,agents:write,inferences:read,inferences:write,credits:read,credits:write
# OPENGRADIENT_BUILDER_RATE_LIMIT_WINDOW_MS=60000
# OPENGRADIENT_BUILDER_RATE_LIMIT_MAX_REQUESTS=60
# OPENGRADIENT_BUILDER_RATE_LIMIT_MAX_WRITE_REQUESTS=20
# OPENGRADIENT_BUILDER_DAILY_INFERENCE_CREATES=
# OPENGRADIENT_BUILDER_DAILY_AGENT_CREATES=
# OPENGRADIENT_BUILDER_DAILY_CREDITS_SPEND_COUNT=
# OPENGRADIENT_BUILDER_DAILY_CREDITS_SPEND_MINA=

# Optional operator membership policy signer for `npm run operators:policy:issue`.
# If omitted, the script generates or reuses `data/opengradient/operator-policy-private-key.txt`.
# OPENGRADIENT_OPERATOR_POLICY_PRIVATE_KEY=
# Optional per-lane membership ordering overrides for deterministic primary/backup assignment.
# Each value is a comma-separated operator ID list from highest to lowest priority.
# OPENGRADIENT_OPERATOR_POLICY_REQUEST_ORDER=
# OPENGRADIENT_OPERATOR_POLICY_OUTPUT_ORDER=
# OPENGRADIENT_OPERATOR_POLICY_REGISTRY_ORDER=
# OPENGRADIENT_OPERATOR_POLICY_CREDITS_ORDER=

# Optional isolated runtime data dir for activated remote operators.
# Use this when launching a same-machine loopback standby so it does not mutate the coordinator-local data dir.
# OPENGRADIENT_REMOTE_DATA_DIR=/absolute/path/to/opengradient-loopback-remote
# Optional remote activation helpers.
# OPENGRADIENT_REMOTE_COORDINATOR_ENDPOINT=http://127.0.0.1:5180
# OPENGRADIENT_REMOTE_STANDBY_MODE=true

# Optional failover smoke controls for `npm run smoke:operator:failover`.
# OPENGRADIENT_FAILOVER_LANE=credits
# OPENGRADIENT_FAILOVER_TIMEOUT_MS=60000
# OPENGRADIENT_FAILOVER_POLL_MS=1500
# Optional live failover settlement smoke amount for `npm run smoke:credits:failover-live`.
# OPENGRADIENT_CREDITS_SPEND_MINA=0.001

# Optional routing policy override.
# Fresh remote operators are selected only when their heartbeat is newer than this threshold.
# OPENGRADIENT_OPERATOR_ROUTE_STALE_MS=90000
# Optional routing strategy override.
# Use membership-first when you want signed operator policy to outrank local hot-standby keys.
# ZEKO_AI_ROUTE_STRATEGY=membership-first
# Optional local isolation helper override for `npm run operators:issue:local-isolation`.
# Set this when the local coordinator should keep a different explicit lane set than the activation manifest.
# OPENGRADIENT_LOCAL_ISOLATION_KEEP_LANES=request,output
